# ==========================================
# 🔐 HANOI REAL ESTATE PLATFORM - ENV CONFIG
# ==========================================

# 1. Google Stitch Design & UI Sync
STITCH_API_KEY=your_stitch_api_key

# 2. App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Supabase (Auth, Postgres, PostGIS, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Mapbox (Map, Geocoding, Static Images)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.xxxxxx
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# 5. Google Gemini AI API
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-pro

# 6. VNPay Gateway Sandbox
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payment/vnpay/callback

# 7. Email Service (Resend / SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@bds-hanoi.vn
